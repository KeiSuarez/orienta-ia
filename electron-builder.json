{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "ar.gob.sssalud.orientaia",
  "productName": "Orienta IA",
  "copyright": "Copyright © 2026 Superintendencia de Servicios de Salud - República Argentina",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/icon.svg",
    "public/pwa-512x512.png",
    "public/pwa-192x192.png",
    "public/apple-touch-icon.png",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/pwa-512x512.png",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publisherName": "Superintendencia de Servicios de Salud"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Orienta IA - SSSalud",
    "uninstallDisplayName": "Orienta IA - Asistente SSSalud"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "public/pwa-512x512.png",
    "category": "public.app-category.government-and-health",
    "artifactName": "${productName}-${version}-Mac-${arch}.${ext}",
    "darkModeSupport": true,
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "dmg": {
    "title": "${productName} ${version} - SSSalud",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 380
    }
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "icon": "public/pwa-512x512.png",
    "category": "Utility",
    "artifactName": "${productName}-${version}-Linux.${ext}"
  }
}
